# ---------------------------------------------------------------------------
# SecretKeyPreview environment configuration
# Copy to .env and adjust. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
SKP_HOST=127.0.0.1
SKP_PORT=4173
SKP_PUBLIC_ORIGIN=https://127.0.0.1:4173
SKP_LOG_LEVEL=info

# --- storage --------------------------------------------------------------
SKP_DATA_DIR=./data
SKP_DB_FILE=secretkeypreview.db

# --- TLS (mandatory, HTTPS only) ------------------------------------------
# Generate with: scripts/setup-tls.sh   (installs a trusted local CA)
SKP_TLS_CERT_PATH=./certs/localhost.pem
SKP_TLS_KEY_PATH=./certs/localhost-key.pem
SKP_TLS_MIN_VERSION=TLSv1.3
SKP_CERTS_DIR=./certs
# Optional loopback-only 308 redirector from HTTP -> HTTPS
SKP_ENABLE_HTTP_REDIRECT=false
SKP_HTTP_REDIRECT_PORT=4180

# --- vault ----------------------------------------------------------------
# Preferred: a 32-byte base64 key stored in the macOS keychain (native mode).
# Container / headless mode: use a file or a passphrase.
# SKP_VAULT_MASTER_KEY_FILE=./secrets/vault_master_key
# SKP_VAULT_MASTER_PASSWORD=change-me-in-a-real-deployment
SKP_VAULT_KEYCHAIN_SERVICE=SecretKeyPreview.vault

# --- auth -----------------------------------------------------------------
SKP_SESSION_IDLE_MINUTES=30
SKP_SESSION_ABSOLUTE_HOURS=12
SKP_PASSWORD_MIN_LENGTH=12
# Google OAuth (Web application client), loopback redirect:
#   https://127.0.0.1:4173/api/v1/auth/google/callback
# SKP_GOOGLE_CLIENT_ID=
# SKP_GOOGLE_CLIENT_SECRET=
# SKP_GOOGLE_ALLOWED_EMAILS=owner@example.com

# --- scanning -------------------------------------------------------------
SKP_SCAN_ROOT=/Users/wongchimanjack
SKP_VERIFY_KEYS_OPT_IN=false

# --- frontend (web package) -----------------------------------------------
VITE_API_ORIGIN=https://127.0.0.1:4173
VITE_DEV_PORT=5173
